#!/usr/bin/env python3
"""Exercise real Model Host speech generation and transcription through Studio MCP."""
import base64
import io
from difflib import SequenceMatcher
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import wave

root = Path(__file__).resolve().parent.parent
provider_name = os.environ.get("ARUVI_SPEECH_TEST_PROVIDER", "Aruvi Model Host (Native Staging)")
voice_model = os.environ.get("ARUVI_SPEECH_TEST_VOICE_MODEL", "piper-ljspeech")
transcription_model = os.environ.get("ARUVI_SPEECH_TEST_STT_MODEL", "whisper-tiny-metal")
phrase = "The quick brown fox jumps over the lazy dog."


def call(tool, action, arguments):
    response = subprocess.run(
        [str(root / "scripts/mcp"), "call", tool, "-"], cwd=root,
        input=json.dumps({"action": action, "arguments": arguments}),
        text=True, capture_output=True, check=True, timeout=180,
    )
    return json.loads(response.stdout)["result"]


try:
    providers = [p for p in call("aruvi_models", "list_providers", {}) if p["name"] == provider_name]
    if len(providers) != 1:
        raise ValueError("Expected exactly one configured speech test provider")
    provider_id = providers[0]["id"]
    audio = call("aruvi_speech", "generate_speech", {
        "provider_id": provider_id, "model": voice_model, "text": phrase,
    })
    if audio["mime_type"] != "audio/wav":
        raise ValueError("Speech provider did not return WAV")
    encoded = audio["audio_bytes_base64"]
    decoded = base64.b64decode(encoded, validate=True)
    with wave.open(io.BytesIO(decoded), "rb") as wav:
        if wav.getnframes() == 0 or wav.getframerate() == 0:
            raise ValueError("Speech provider returned empty WAV audio")
    result = call("aruvi_speech", "transcribe_audio", {
        "provider_id": provider_id, "model_name": transcription_model,
        "audio_bytes_base64": encoded, "mime_type": "audio/wav", "locale": "en",
    })
    words = re.findall(r"[a-z]+", result["transcript"].lower())
    expected = re.findall(r"[a-z]+", phrase.lower())
    similarity = SequenceMatcher(None, expected, words, autojunk=False).ratio()
    if similarity < 0.7 or not {"fox", "dog"}.issubset(words):
        raise ValueError(f"Synthetic transcription mismatch (word similarity {similarity:.2f})")
    print(f"Real speech round trip passed through Studio MCP ({voice_model}, {transcription_model}).")
except (OSError, KeyError, ValueError, wave.Error, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
    detail = str(error) if isinstance(error, ValueError) else type(error).__name__
    print(f"Speech round trip failed: {detail}", file=sys.stderr)
    sys.exit(1)
