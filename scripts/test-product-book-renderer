#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/aruvi-render-test.XXXXXX")"
trap 'rm -rf "$temp_dir"' EXIT
cd "$root"
export ARUVI_BOOK_PARITY_FIXTURE_PATH="$temp_dir/fixture.json"
npx vitest run src/features/products/lib/productBookBackend.test.ts
npx playwright test e2e/product-book-export.spec.js --workers=1
cargo test --locked --manifest-path src-tauri/Cargo.toml --lib embedded_renderer_matches_desktop_output -- --ignored
