#!/usr/bin/env python3
"""Exercise the configured Model Host coding fixture through Studio MCP."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
name = "Aruvi Model Host (Studio Coding Validation)"
model = os.environ.get("ARUVI_CODING_TEST_MODEL", "qwen25-coder-15b-q4")

def call(action, arguments):
    result = subprocess.run([str(root / "scripts/mcp"), "call", "aruvi_models", "-"], cwd=root,
                            input=json.dumps({"action": action, "arguments": arguments}),
                            text=True, capture_output=True, check=True)
    return json.loads(result.stdout)["result"]

try:
    providers = [provider for provider in call("list_providers", {}) if provider["name"] == name]
    if len(providers) != 1:
        raise ValueError("Expected one configured coding validation provider")
    response = call("run_model_chat_completion", {
        "provider_id": providers[0]["id"], "model": model,
        "messages": [
            {"role": "system", "content": "You are a programming assistant. Return only the requested JavaScript function without markdown or explanations."},
            {"role": "user", "content": "Write function sumEven(numbers) that returns the sum of the even integers in numbers. Return 0 for an empty array."},
        ], "temperature": 0.1, "max_tokens": 200,
    })
    code = response["content"]
    fenced = re.search(r"```(?:javascript|js)?\s*\n(.*?)```", code, re.DOTALL | re.IGNORECASE)
    if fenced:
        code = fenced.group(1)
    if not code or len(code.encode()) > 8192:
        raise ValueError("Model response is empty or exceeds the coding fixture limit")
    assertions = """
const assert = require('node:assert/strict');
assert.equal(sumEven([1, 2, 3, 4, -2]), 4);
assert.equal(sumEven([]), 0);
assert.equal(sumEven([-3, 0, 3]), 0);
console.log('Coding fixture passed');
"""
    run = subprocess.run([
        "docker", "run", "--rm", "-i", "--network", "none", "--read-only", "--memory", "256m",
        "--cpus", "1", "--pids-limit", "32", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
        "--user", "65534:65534", "node:22-bookworm-slim", "node",
    ], input=code + assertions, text=True, capture_output=True, timeout=30)
    if run.returncode:
        raise ValueError("Generated code failed the isolated JavaScript assertions")
    # A real token-limited response must not be accepted as a completed answer.
    limited = {"action": "run_model_chat_completion", "arguments": {
        "provider_id": providers[0]["id"], "model": model,
        "messages": [{"role": "user", "content": "Write a detailed explanation of recursion with three code examples."}],
        "temperature": 0.1, "max_tokens": 1,
    }}
    limited_result = subprocess.run([str(root / "scripts/mcp"), "call", "aruvi_models", "-"], cwd=root,
                                    input=json.dumps(limited), text=True, capture_output=True)
    if limited_result.returncode == 0 or "truncated by a token limit" not in limited_result.stderr:
        raise ValueError("Token-limited request did not produce the expected truncation error")
    print(f"Coding fixture and token-limit error passed through Studio MCP; output tokens: {response.get('token_count_output')}")
except (OSError, KeyError, ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
    print(f"Coding fixture failed: {type(error).__name__}: {error if not isinstance(error, subprocess.CalledProcessError) else 'MCP call failed'}", file=sys.stderr)
    sys.exit(1)
