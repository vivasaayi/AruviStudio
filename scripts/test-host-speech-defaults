#!/usr/bin/env python3
"""Validate real Model Host transcription defaults in a disposable Studio fixture."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.request

root = Path(__file__).resolve().parent.parent
host = root.parent / "aruvi-model-host"
container = volume = pdf_volume = None
created = owned = False

def command(args, **kwargs):
    return subprocess.check_output(args, text=True, **kwargs).strip()

def envfile(path):
    return dict(line.split("=", 1) for line in path.read_text().splitlines() if line and not line.startswith("#") and "=" in line)

try:
    studio = json.loads(command(["bash", "scripts/env", "worktree", "plan"], cwd=root))
    studio_file = Path(studio["state"]) / "environment.env"
    host_env = dict(os.environ, ARUVI_MODEL_HOST_ENV="native")
    plan = json.loads(command(["bash", "scripts/env", "integration", "plan"], cwd=host, env=host_env))
    status = json.loads(command(["bash", "scripts/env", "integration", "status"], cwd=host, env=host_env))
    url = status["endpoint"]["url"]
    if not status["registered"] or not url.startswith("http://127.0.0.1:"):
        raise ValueError("Expected a running loopback Model Host")
    port = int(url.rsplit(":", 1)[1])
    token = envfile(Path(plan["state"]) / "environment.env")["MODEL_HOST_TOKEN"]
    suffix = str(os.getpid())
    container = f'{studio["project"]}-speech-defaults-{suffix}'
    volume = f'{studio["project"]}_speech_defaults_socket_{suffix}'
    pdf_volume = volume + "_pdf"
    for kind, name in [("container", container), ("volume", volume), ("volume", pdf_volume)]:
        if subprocess.run(["docker", kind, "inspect", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            raise ValueError("Disposable fixture name already exists")
    owned = True
    compose_env = dict(os.environ, APP_IMAGE=envfile(studio_file)["APP_IMAGE"], PRODUCT_SOURCE=str(root), TEST_SOCKET_NAME=volume, TEST_PDF_SOCKET_NAME=pdf_volume, COMPOSE_IGNORE_ORPHANS="true")
    compose = ["docker", "compose", "--project-name", studio["project"], "--project-directory", str(root), "--env-file", str(studio_file), "-f", str(root / "deploy/compose.test.yaml")]
    command(compose + ["run", "--rm", "-d", "--name", container, "-p", "127.0.0.1::8787", "fixture"], env=compose_env)
    created = True
    subprocess.run(["docker", "exec", "-i", container, "sh", "-c", "umask 077; cat > /data/llm-config.json"], input=json.dumps({"refs": {"speech-fixture": token}}), text=True, check=True)
    address = command(["docker", "port", container, "8787/tcp"]).splitlines()[0]
    if not address.startswith("127.0.0.1:"): raise ValueError("Fixture must be loopback-only")
    deadline = time.monotonic() + 30
    while True:
        try:
            with urllib.request.urlopen(f"http://{address}/health", timeout=2) as response:
                if response.status == 200: break
        except OSError:
            if time.monotonic() >= deadline: raise ValueError("Fixture did not become healthy")
            time.sleep(0.25)
    def mcp(tool, action, arguments):
        body = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": tool, "arguments": {"action": action, "arguments": arguments}}}
        request = urllib.request.Request(f"http://{address}/api/mcp", data=json.dumps(body).encode(), headers={"Authorization": "Bearer workflow-mcp-test", "Content-Type": "application/json", "Accept": "application/json"})
        with urllib.request.urlopen(request, timeout=180) as response: result = json.load(response)["result"]
        if result.get("isError"): raise ValueError("Fixture MCP action failed: " + action)
        return result["structuredContent"]["result"]
    provider = mcp("aruvi_models", "create_provider", {"name": "Speech defaults fixture", "base_url": f"http://host.docker.internal:{port}/v1", "auth_secret_ref": "ref:speech-fixture"})
    mcp("aruvi_models", "create_model_definition", {"provider_id": provider["id"], "name": "whisper-tiny-metal", "capability_tags": ["transcription"]})
    audio = mcp("aruvi_speech", "generate_speech", {"provider_id": provider["id"], "model": "piper-ljspeech", "text": "The quick brown fox jumps over the lazy dog."})
    browser = subprocess.run(["node", "scripts/test-host-speech-defaults-ui.mjs"], cwd=root, input=json.dumps({"address": address, "provider": provider["id"], "audio": audio["audio_bytes_base64"]}), text=True, capture_output=True, timeout=180)
    if browser.returncode: raise ValueError("Browser speech defaults fixture failed: " + browser.stderr[-1500:])
    print(browser.stdout.strip())
    result = mcp("aruvi_speech", "transcribe_audio", {"audio_bytes_base64": audio["audio_bytes_base64"], "mime_type": "audio/wav"})
    if not {"fox", "dog"}.issubset(set(result["transcript"].lower().replace(".", "").split())): raise ValueError("MCP default transcription did not contain expected words")
    print("MCP used the same server defaults for real Model Host transcription.")
except (OSError, KeyError, TypeError, ValueError, subprocess.SubprocessError) as error:
    print(f"Speech defaults fixture failed: {type(error).__name__}: {error if isinstance(error, ValueError) else 'fixture command failed'}", file=sys.stderr)
    sys.exit(1)
finally:
    if created: subprocess.run(["docker", "rm", "-f", container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if owned: subprocess.run(["docker", "volume", "rm", volume, pdf_volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
