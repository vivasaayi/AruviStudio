#!/usr/bin/env python3
"""Validate a scoped Model Host candidate with a real local model and disposable Studio."""
import argparse
import contextlib
import hashlib
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--host-binary', type=Path, required=True)
parser.add_argument('--worker-binary', type=Path, required=True)
parser.add_argument('--model-file', type=Path, required=True)
parser.add_argument('--studio-image', required=True)
parser.add_argument('--browser', action='store_true', help='Also exercise streaming in a local Chrome browser')
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
host = container = None
phase = 'input validation'
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

def stop_host(process):
    if process is not None and process.poll() is None:
        process.terminate()
        try: process.wait(timeout=20)
        except subprocess.TimeoutExpired:
            process.kill(); process.wait()


def stop_container(identifier):
    if identifier: subprocess.run(['docker','stop',identifier], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

try:
    host_binary = args.host_binary.resolve(strict=True)
    worker_binary = args.worker_binary.resolve(strict=True)
    model_file = args.model_file.resolve(strict=True)
    if not host_binary.is_file() or not worker_binary.is_file() or not model_file.is_file():
        raise ValueError('Expected regular host, worker and model files')
    phase = 'model checksum'
    digest = hashlib.sha256()
    with model_file.open('rb') as source:
        for block in iter(lambda: source.read(1024 * 1024), b''): digest.update(block)
    admin, scoped, studio_token = (secrets.token_urlsafe(32) for _ in range(3))
    with tempfile.TemporaryDirectory(prefix='aruvi-scoped-real-', dir='/private/tmp') as directory, contextlib.ExitStack() as cleanup:
        state = Path(directory) / 'host'
        env = {key:value for key,value in os.environ.items() if not key.startswith(('MODEL_HOST_', 'ARUVI_', 'HF_TOKEN'))}
        env.update(MODEL_HOST_BIND='127.0.0.1:0', MODEL_HOST_DATA=str(state), MODEL_HOST_LLAMA_BIN=str(worker_binary),
                   MODEL_HOST_TOKEN=admin, MODEL_HOST_INFERENCE_TOKEN=scoped, MODEL_HOST_MAX_LOADED='1',
                   MODEL_HOST_MEMORY_MB='2048', MODEL_HOST_LOAD_TIMEOUT_SECONDS='180', MODEL_HOST_REQUEST_TIMEOUT_SECONDS='180')
        phase = 'candidate host startup'
        host = subprocess.Popen([str(host_binary)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cleanup.callback(stop_host, host)
        deadline = time.monotonic() + 45
        while not (state / 'endpoint.json').exists():
            if host.poll() is not None or time.monotonic() > deadline: raise ValueError('Candidate host did not start')
            time.sleep(.1)
        url = json.loads((state / 'endpoint.json').read_text())['url']
        if not url.startswith('http://127.0.0.1:'): raise ValueError('Candidate host is not loopback-only')
        port = int(url.rsplit(':', 1)[1])
        def host_request(path, token, body=None, timeout=20):
            request = urllib.request.Request(url + path, data=json.dumps(body).encode() if body is not None else None,
                headers={'Authorization':'Bearer ' + token, 'Content-Type':'application/json'})
            with opener.open(request, timeout=timeout) as response: return json.load(response)
        definition = {'id':'scoped-real-model', 'memory_mb':1024, 'context_size':2048, 'gpu_layers':0,
                      'source':{'kind':'local', 'path':str(model_file), 'sha256':digest.hexdigest()}}
        phase = 'model registration and installation'
        host_request('/api/models', admin, definition)
        host_request('/api/models/scoped-real-model/install', admin, {})
        deadline = time.monotonic() + 120
        while True:
            record = host_request('/api/models/scoped-real-model', admin)
            if record['installation'] == 'installed': break
            if record['installation'] == 'failed' or time.monotonic() > deadline: raise ValueError('Model installation failed')
            time.sleep(.2)
        phase = 'credential authorization'
        try:
            host_request('/api/models', scoped)
            raise ValueError('Scoped credential reached management')
        except urllib.error.HTTPError as error:
            if error.code != 403: raise
        if not any(item['id'] == 'scoped-real-model' for item in host_request('/v1/models', scoped)['data']):
            raise ValueError('Scoped discovery did not list the model')
        phase = 'Studio container startup'
        result = subprocess.run(['docker','run','-d','--rm','--tmpfs','/data:mode=1777','--tmpfs','/repositories:mode=1777',
            '-p','127.0.0.1::8787','-e','ARUVI_MOBILE_API_TOKEN=' + studio_token, '-e','ARUVI_MCP_API_TOKEN=' + studio_token,
            '-e','ARUVI_LLM_CONFIG_PATH=/data/llm.json',args.studio_image], capture_output=True, text=True, check=True)
        container = result.stdout.strip()
        cleanup.callback(stop_container, container)
        address = subprocess.check_output(['docker','port',container,'8787/tcp'], text=True).strip().splitlines()[0]
        if not address.startswith('127.0.0.1:'): raise ValueError('Studio fixture is not loopback-only')
        base = 'http://' + address
        deadline = time.monotonic() + 45
        while True:
            try:
                with opener.open(base + '/health', timeout=2): break
            except OSError:
                if time.monotonic() > deadline: raise ValueError('Studio fixture did not start')
                time.sleep(.2)
        def studio_post(path, payload, timeout=180):
            request = urllib.request.Request(base + path, data=json.dumps(payload).encode(),
                headers={'Authorization':'Bearer ' + studio_token, 'Content-Type':'application/json'})
            return opener.open(request, timeout=timeout)
        def mcp(action, arguments):
            body = {'jsonrpc':'2.0','id':1,'method':'tools/call','params':{'name':'aruvi_models','arguments':{'action':action,'arguments':arguments}}}
            with studio_post('/api/mcp', body) as response: result = json.load(response)['result']
            if result.get('isError'): raise ValueError('Studio MCP action failed: ' + action)
            return result['structuredContent']['result']
        phase = 'Studio MCP completion'
        provider = mcp('create_provider', {'name':'scoped-real-fixture', 'base_url':f'http://host.docker.internal:{port}/v1', 'auth_secret_ref':scoped})
        mcp('create_model_definition', {'provider_id':provider['id'], 'name':'scoped-real-model'})
        prompt = [{'role':'user','content':'Reply with exactly the word READY.'}]
        result = mcp('run_model_chat_completion', {'provider_id':provider['id'], 'model':'scoped-real-model', 'messages':prompt, 'max_tokens':64, 'temperature':0})
        if 'ready' not in result['content'].lower(): raise ValueError('Real model did not answer the fixture prompt')
        phase = 'Studio streaming'
        with studio_post('/api/mobile/chat/stream', {'provider_id':provider['id'], 'model_name':'scoped-real-model', 'messages':prompt, 'max_tokens':64, 'temperature':0}) as response:
            events, size = [], 0
            for line in response:
                size += len(line)
                if size > 2 * 1024 * 1024: raise ValueError('Stream exceeded fixture limit')
                if line.strip(): events.append(json.loads(line))
        if not events or events[-1].get('type') != 'done' or any(event.get('type') != 'delta' for event in events[:-1]) or 'ready' not in ''.join(event.get('content','') for event in events[:-1]).lower():
            raise ValueError('Real model streaming did not complete the fixture')
        print('Disposable real-model host: scoped discovery, denied management, Docker Studio MCP and browser API streaming passed.')
        if args.browser:
            phase = 'browser streaming'
            fixture = {'address':base, 'token':studio_token, 'provider':provider['id'], 'model':'scoped-real-model'}
            result = subprocess.run(['node', str(root / 'scripts/test-scoped-real-host-ui.mjs')], input=json.dumps(fixture), capture_output=True, text=True, timeout=200)
            if result.returncode != 0: raise ValueError('Browser fixture failed')
            print('Disposable browser streaming completed with the scoped credential.')
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError, urllib.error.URLError) as error:
    print('Scoped real-host validation failed during ' + phase + ' (' + type(error).__name__ + ')', file=sys.stderr)
    sys.exit(1)
finally:
    stop_container(container)
    stop_host(host)
