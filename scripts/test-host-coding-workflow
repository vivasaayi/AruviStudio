#!/usr/bin/env python3
"""Run a real local coding workflow in a disposable Studio fixture container."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.request

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("host", nargs="?", type=Path, default=root.parent / "aruvi-model-host-studio-validation")
parser.add_argument("--scenario", choices=("new-module", "extend-module"), default="new-module")
parser.add_argument("--json-mode", action="store_true", help="Opt the disposable coding agent into JSON-object output")
parser.add_argument("--verify-gate-rejects-invalid", action="store_true", help="Prove an invalid JavaScript fixture fails the workflow test gate")
parser.add_argument("--verify-behavior-rejection", action="store_true", help="Prove the independent behavioral review blocks delivery of invalid exports")
parser.add_argument("--other-stage-model", help="Use another installed model for non-coding agents in this disposable fixture")
args = parser.parse_args()
host = args.host.expanduser().resolve()
container = None
volume = None
pdf_volume = None
container_created = False
volume_owned = False

def command(argv, **kwargs):
    return subprocess.check_output(argv, text=True, **kwargs).strip()

def environment(path):
    return dict(line.split("=", 1) for line in path.read_text().splitlines() if line and not line.startswith("#") and "=" in line)

try:
    studio = json.loads(command(["bash", "scripts/env", "worktree", "plan"], cwd=root))
    envfile = Path(studio["state"]) / "environment.env"
    studio_env = environment(envfile)
    native_env = dict(os.environ, ARUVI_MODEL_HOST_ENV="native")
    plan = json.loads(command(["bash", "scripts/env", "worktree", "plan"], cwd=host, env=native_env))
    status = json.loads(command(["bash", "scripts/env", "worktree", "status"], cwd=host, env=native_env))
    native_url = status["endpoint"]["url"]
    if not status["registered"] or not native_url.startswith("http://127.0.0.1:"):
        raise ValueError("Expected a running loopback native host worktree")
    token = environment(Path(plan["state"]) / "environment.env")["MODEL_HOST_TOKEN"]
    host_port = int(native_url.rsplit(":", 1)[1])
    suffix = str(os.getpid())
    container = f'{studio["project"]}-real-coding-{suffix}'
    volume = f'{studio["project"]}_real_coding_socket_{suffix}'
    pdf_volume = volume + "_pdf"
    if subprocess.run(["docker", "inspect", container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        raise ValueError("Disposable fixture container name is already in use")
    if subprocess.run(["docker", "volume", "inspect", volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        raise ValueError("Disposable fixture volume name is already in use")
    if subprocess.run(["docker", "volume", "inspect", pdf_volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        raise ValueError("Disposable PDF fixture volume name is already in use")
    volume_owned = True
    compose_env = dict(os.environ, APP_IMAGE=studio_env["APP_IMAGE"], PRODUCT_SOURCE=str(root), TEST_SOCKET_NAME=volume, TEST_PDF_SOCKET_NAME=pdf_volume, COMPOSE_IGNORE_ORPHANS="true")
    compose = ["docker", "compose", "--project-name", studio["project"], "--project-directory", str(root), "--env-file", str(envfile), "-f", str(root / "deploy/compose.test.yaml")]
    command(compose + ["run", "--rm", "-d", "--name", container, "-p", "127.0.0.1::8787", "fixture"], env=compose_env)
    container_created = True
    subprocess.run(["docker", "exec", "-i", container, "sh", "-c", "umask 077; cat > /data/llm-config.json"], input=json.dumps({"refs": {"coding-fixture": token}}), text=True, check=True)
    # Syntax checking does not execute model-generated code. Copy only the Node
    # executable into this disposable fixture; behavioral assertions below run
    # separately with no network or access to the fixture's credentials.
    producer = subprocess.Popen(["docker", "run", "--rm", "--network", "none", "--read-only", "--entrypoint", "cat", "node:22-bookworm-slim", "/usr/local/bin/node"], stdout=subprocess.PIPE)
    try:
        subprocess.run(["docker", "exec", "-i", container, "sh", "-c", "cat > /tmp/aruvi-fixture-node && chmod 755 /tmp/aruvi-fixture-node"], stdin=producer.stdout, check=True)
    finally:
        if producer.stdout: producer.stdout.close()
        producer.wait()
    if producer.returncode: raise ValueError("Unable to prepare the disposable syntax checker")
    node_check = subprocess.run(["docker", "exec", container, "/tmp/aruvi-fixture-node", "--version"], text=True, capture_output=True)
    if node_check.returncode: raise ValueError(f"Syntax checker could not start (exit {node_check.returncode}): " + node_check.stderr[:500])
    if args.verify_gate_rejects_invalid:
        subprocess.run(["docker", "exec", "-i", container, "sh", "-c", "cat > /tmp/aruvi-invalid-syntax.js"], input="function broken( {\n", text=True, check=True)
    command(["docker", "exec", container, "sh", "-c", 'mkdir -p /repositories/coding-fixture && git init -q -b main /repositories/coding-fixture && git -C /repositories/coding-fixture config user.name "Fixture" && git -C /repositories/coding-fixture config user.email "fixture@example.invalid" && printf "# Fixture\\n" > /repositories/coding-fixture/README.md && git -C /repositories/coding-fixture add README.md && git -C /repositories/coding-fixture commit -q -m initial && git init -q --bare /repositories/coding-origin.git && git -C /repositories/coding-fixture remote add origin /repositories/coding-origin.git && git -C /repositories/coding-fixture push -q -u origin main'])
    if args.scenario == "extend-module":
        original = "function sumEven(numbers) { return numbers.filter(n => n % 2 === 0).reduce((a, b) => a + b, 0); }\nmodule.exports = { sumEven };\n"
        subprocess.run(["docker", "exec", "-i", container, "sh", "-c", "mkdir -p /repositories/coding-fixture/src && cat > /repositories/coding-fixture/src/math.js"], input=original, text=True, check=True)
        command(["docker", "exec", container, "sh", "-c", "git -C /repositories/coding-fixture add src/math.js && git -C /repositories/coding-fixture commit -q -m 'Seed existing math module' && git -C /repositories/coding-fixture push -q origin main"])
    address = command(["docker", "port", container, "8787/tcp"]).splitlines()[0]
    if not address.startswith("127.0.0.1:"):
        raise ValueError("Fixture endpoint is not loopback-only")
    deadline = time.monotonic() + 30
    while True:
        try:
            with urllib.request.urlopen(f"http://{address}/health", timeout=2) as response:
                if response.status == 200: break
        except (OSError, urllib.error.URLError):
            if time.monotonic() >= deadline: raise ValueError("Disposable Studio fixture did not become healthy")
            time.sleep(0.25)
    def call(tool, action, arguments):
        payload = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": tool, "arguments": {"action": action, "arguments": arguments}}}).encode()
        request = urllib.request.Request(f"http://{address}/api/mcp", data=payload, headers={"Authorization": "Bearer workflow-mcp-test", "Content-Type": "application/json", "Accept": "application/json"})
        with urllib.request.urlopen(request, timeout=240) as response:
            result = json.load(response)
        if "error" in result: raise ValueError(result["error"].get("message", "MCP failed"))
        result = result["result"]
        if result.get("isError"): raise ValueError("MCP " + action + " failed: " + "; ".join(item.get("text", "") for item in result.get("content", []))[:500])
        return result["structuredContent"]["result"]
    provider = call("aruvi_models", "create_provider", {"name": "Real coding fixture", "base_url": f"http://host.docker.internal:{host_port}/v1", "auth_secret_ref": "ref:coding-fixture"})
    model_name = os.environ.get("ARUVI_CODING_TEST_MODEL", "qwen25-coder-15b-q4")
    model = call("aruvi_models", "create_model_definition", {"provider_id": provider["id"], "name": model_name})
    other = model if not args.other_stage_model or args.other_stage_model == model_name else call("aruvi_models", "create_model_definition", {"provider_id": provider["id"], "name": args.other_stage_model})
    agents = call("aruvi_agents", "list_agent_definitions", {})
    for agent in agents:
        if agent["enabled"]:
            selected = model if agent["id"] == "coding-agent" else other
            call("aruvi_agents", "set_primary_agent_model_binding", {"agent_id": agent["id"], "model_id": selected["id"]})
    if args.json_mode:
        coding = next((agent for agent in agents if agent["id"] == "coding-agent" and agent["enabled"]), None)
        if not coding: raise ValueError("Disposable coding agent is unavailable")
        boundaries = dict(coding["boundaries"])
        boundaries["json_object_output"] = True
        call("aruvi_agents", "update_agent_definition", {"id": coding["id"], "boundaries": boundaries})
    test_file = "/tmp/aruvi-invalid-syntax.js" if args.verify_gate_rejects_invalid else "src/math.js"
    for key, value in [("workflow.auto_start_after_work_item_approval", "false"), ("workflow.auto_approve_plan", "false"), ("workflow.auto_approve_test_review", "false"), ("workflow.test_argv", json.dumps(["/tmp/aruvi-fixture-node", "--check", test_file]))]:
        call("aruvi_settings", "set_setting", {"key": key, "value": value})
    product = call("aruvi_catalog", "create_product", {"name": "Disposable real coding evaluation"})
    repo = call("aruvi_repositories", "register_repository", {"name": "Coding fixture", "local_path": "/repositories/coding-fixture", "default_branch": "main"})
    call("aruvi_repositories", "attach_repository", {"scope_type": "product", "scope_id": product["id"], "repository_id": repo["id"], "is_default": True})
    if args.scenario == "extend-module":
        title = "Extend existing math module"
        description = ("Edit the existing src/math.js. Preserve sumEven and add clamp(value, min, max). "
                       "Return min if value is below min, max if above max, otherwise return value. "
                       "Throw RangeError if min is greater than max. Export both functions through module.exports.")
    else:
        title = "Add sumEven"
        description = "Create src/math.js containing function sumEven(numbers) that returns the sum of even integers, and export it as module.exports = { sumEven }. Return 0 for an empty array."
    item = call("aruvi_work_items", "create_work_item", {"product_id": product["id"], "title": title, "description": description, "work_item_type": "task"})
    call("aruvi_checkpoints", "approve_work_item", {"work_item_id": item["id"]})
    run_id = call("aruvi_workflows", "start_work_item_workflow", {"work_item_id": item["id"]})["workflow_run_id"]
    run = call("aruvi_workflows", "get_workflow_run", {"workflow_run_id": run_id})
    print("Stage after planning:", run["current_stage"], flush=True)
    if run["current_stage"] != "pending_plan_approval": raise ValueError("Workflow did not reach plan approval")
    def print_coding_trace():
        artifacts = call("aruvi_checkpoints", "list_work_item_artifacts", {"work_item_id": item["id"]})
        for artifact in artifacts:
            if artifact.get("artifact_type") == "coding_tool_trace":
                trace = call("aruvi_checkpoints", "read_artifact_content", {"artifact_id": artifact["id"]})
                print("Coding trace:", trace["content"][:5000], flush=True)
    try:
        call("aruvi_workflows", "handle_workflow_user_action", {"workflow_run_id": run_id, "action": "approve"})
    except ValueError as failure:
        print_coding_trace()
        if args.verify_gate_rejects_invalid:
            artifacts = call("aruvi_checkpoints", "list_work_item_artifacts", {"work_item_id": item["id"]})
            matches = [artifact for artifact in artifacts if artifact.get("artifact_type") == "workflow_test_result" and artifact.get("workflow_run_id") == run_id]
            if len(matches) != 1: raise ValueError("Expected a failed workflow test artifact") from failure
            report = json.loads(call("aruvi_checkpoints", "read_artifact_content", {"artifact_id": matches[0]["id"]})["content"])
            if report.get("status") != "failed" or report.get("exit_code") in (None, 0): raise ValueError("Invalid syntax was not rejected by the workflow test gate") from failure
            if "aruvi-invalid-syntax.js" not in report.get("stderr", ""): raise ValueError("Workflow test failed for an unexpected reason") from failure
            remote_has_file = subprocess.run(["docker", "exec", container, "git", "--git-dir=/repositories/coding-origin.git", "cat-file", "-e", "main:src/math.js"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if remote_has_file.returncode == 0: raise ValueError("Failed test was delivered to the remote") from failure
            print("Workflow test gate rejected invalid syntax and did not deliver", flush=True)
            sys.exit(0)
        try:
            artifacts = call("aruvi_checkpoints", "list_work_item_artifacts", {"work_item_id": item["id"]})
            for artifact in artifacts:
                if artifact.get("artifact_type") == "workflow_test_result" and artifact.get("workflow_run_id") == run_id:
                    report = call("aruvi_checkpoints", "read_artifact_content", {"artifact_id": artifact["id"]})
                    print("Workflow test result:", report["content"][:2000], flush=True)
        except (OSError, KeyError, TypeError, ValueError):
            print("Workflow test result unavailable", flush=True)
        # The fixture is disposable and the ledger fields below contain no prompt,
        # completion, or provider credentials. They identify the failing stage
        # and token budget even when the workflow stops before test review.
        try:
            request = urllib.request.Request(f"http://{address}/api/mobile/model-calls?limit=100", headers={"Authorization": "Bearer workflow-mobile-test"})
            with urllib.request.urlopen(request, timeout=10) as response:
                calls = json.load(response)
            for entry in calls:
                if entry.get("workflow_run_id") == run_id:
                    print("Model call:", json.dumps({key: entry.get(key) for key in ("stage", "source_label", "status", "max_tokens", "token_count_input", "token_count_output")}), flush=True)
        except (OSError, ValueError, TypeError):
            print("Model call diagnostics unavailable", flush=True)
        raise
    run = call("aruvi_workflows", "get_workflow_run", {"workflow_run_id": run_id})
    print("Stage after coding:", run["current_stage"], flush=True)
    if run["current_stage"] != "pending_test_review": raise ValueError("Workflow did not reach test review")
    print_coding_trace()
    artifacts = call("aruvi_checkpoints", "list_work_item_artifacts", {"work_item_id": item["id"]})
    test_artifacts = [artifact for artifact in artifacts if artifact.get("artifact_type") == "workflow_test_result" and artifact.get("workflow_run_id") == run_id]
    if len(test_artifacts) != 1: raise ValueError("Expected one workflow test result artifact")
    test_result = json.loads(call("aruvi_checkpoints", "read_artifact_content", {"artifact_id": test_artifacts[0]["id"]})["content"])
    if test_result.get("status") != "passed" or test_result.get("exit_code") != 0:
        raise ValueError("Workflow syntax check did not pass")
    print("Workflow syntax check passed", flush=True)
    file = call("aruvi_repositories", "read_repository_file", {"repository_id": repo["id"], "relative_path": "src/math.js"})
    code = file["content"]
    assertions = "\nconst assert = require('node:assert/strict'); const f = module.exports.sumEven; assert.equal(f([1,2,3,4,-2]),4); assert.equal(f([]),0);\n"
    if args.scenario == "extend-module":
        assertions += "const c = module.exports.clamp; assert.equal(c(-5,0,10),0); assert.equal(c(5,0,10),5); assert.equal(c(12,0,10),10); assert.equal(c(2,2,2),2); assert.throws(() => c(3,9,1), RangeError);\n"
    assertions += "console.log('generated code passed');\n"
    if not code or len(code.encode()) > 8192: raise ValueError("Generated file missing or oversized")
    review_code = "module.exports = {};\n" if args.verify_behavior_rejection else code
    check = subprocess.run(["docker", "run", "--rm", "-i", "--network", "none", "--read-only", "--memory", "256m", "--cpus", "1", "--pids-limit", "32", "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--user", "65534:65534", "node:22-bookworm-slim", "node"], input=review_code+assertions, text=True, capture_output=True, timeout=30)
    if check.returncode:
        remote = subprocess.run(["docker", "exec", container, "git", "--git-dir=/repositories/coding-origin.git", "show", "main:src/math.js"], text=True, capture_output=True)
        unchanged = (remote.returncode == 0 and remote.stdout == original) if args.scenario == "extend-module" else remote.returncode != 0
        if not unchanged: raise ValueError("Behavioral review failed but the disposable remote changed")
        if args.verify_behavior_rejection:
            print("Behavioral review rejected invalid exports before approval; disposable remote unchanged", flush=True)
            sys.exit(0)
        raise ValueError("Workflow-generated code failed the isolated assertions: " + check.stderr.strip()[:500])
    if args.verify_behavior_rejection: raise ValueError("Expected invalid exports to fail behavioral review")
    call("aruvi_workflows", "handle_workflow_user_action", {"workflow_run_id": run_id, "action": "approve"})
    run = call("aruvi_workflows", "get_workflow_run", {"workflow_run_id": run_id})
    if run["current_stage"] != "done": raise ValueError("Workflow did not finish")
    delivered = command(["docker", "exec", container, "git", "--git-dir=/repositories/coding-origin.git", "show", "main:src/math.js"])
    if delivered.strip() != code.strip(): raise ValueError("The disposable Git remote does not contain the verified file")
    print(f"Disposable real-model {args.scenario} workflow and generated-code assertions passed")
except (OSError, KeyError, TypeError, ValueError, subprocess.SubprocessError) as error:
    print(f"Real coding workflow failed: {type(error).__name__}: {error if not isinstance(error, subprocess.CalledProcessError) else 'fixture command failed'}", file=sys.stderr)
    sys.exit(1)
finally:
    if container_created:
        subprocess.run(["docker", "rm", "-f", container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if volume_owned:
        subprocess.run(["docker", "volume", "rm", volume, pdf_volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
