#!/usr/bin/env python3
"""Validate the pinned Tiny English preset with synthetic Model Host speech."""
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("model", type=Path, help="Downloaded ggml-tiny.en.bin preset")
parser.add_argument("--container", action="store_true", help="Run browser and MCP workflows in a disposable Linux container")
args = parser.parse_args()
expected = "921e4cf8686fdd993dcd081a5da5b6c365bfde1162e72b08d75ac75289920b1f"

def call(tool, action, arguments):
    payload = json.dumps({"action": action, "arguments": arguments})
    response = subprocess.run([str(root / "scripts/mcp"), "call", tool, "-"], cwd=root,
                              input=payload, text=True, capture_output=True, check=True, timeout=180)
    return json.loads(response.stdout)["result"]

try:
    model = args.model.expanduser().resolve(strict=True)
    digest = hashlib.sha256()
    with model.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""): digest.update(chunk)
    if digest.hexdigest() != expected: raise ValueError("Model checksum does not match the pinned Tiny English preset")
    providers = [provider for provider in call("aruvi_models", "list_providers", {}) if provider["name"] == "Aruvi Model Host (Native Staging)"]
    if len(providers) != 1: raise ValueError("Expected exactly one native staging speech provider")
    audio = call("aruvi_speech", "generate_speech", {"provider_id": providers[0]["id"], "model": "piper-ljspeech", "text": "The quick brown fox jumps over the lazy dog."})
    if audio.get("mime_type") != "audio/wav": raise ValueError("Speech generation did not return WAV")
    with tempfile.TemporaryDirectory(prefix="aruvi-local-speech-") as directory:
        fixture = Path(directory) / "synthetic.wav"
        fixture.write_bytes(base64.b64decode(audio["audio_bytes_base64"], validate=True))
        fixture.chmod(0o600)
        if args.container:
            env = dict(os.environ, ARUVI_TEST_WHISPER_MODEL=str(model), ARUVI_TEST_WHISPER_AUDIO=str(fixture))
            env.pop("ARUVI_TEST_WHISPER_DOWNLOAD", None)
            subprocess.run(["bash", "scripts/test-container-workflow.sh"], cwd=root, env=env, check=True)
        else:
            env = dict(os.environ, ARUVI_LOCAL_WHISPER_MODEL=str(model), ARUVI_LOCAL_WHISPER_AUDIO=str(fixture))
            subprocess.run(["cargo", "test", "--locked", "--manifest-path", "src-tauri/Cargo.toml", "--lib",
                            "local_whisper_transcribes_synthetic_fixture", "--", "--ignored"], cwd=root, env=env, check=True)
    print("Pinned local Tiny English model transcribed synthetic Model Host audio" + (" through the browser UI, browser API and MCP in a container." if args.container else "."))
except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
    print(f"Local Whisper preset check failed ({type(error).__name__})", file=sys.stderr)
    sys.exit(1)
