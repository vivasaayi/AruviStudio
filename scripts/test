#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
case "${1:-}" in
  unit) npm run terminology-check && npm run unit-test && npm run test:frontend ;;
  integration) npm run integration-test ;;
  host-layout) node scripts/test-host-layout.mjs ;;
  model-routing) python3 scripts/test-model-routing.py ;;
  sqlx-patch) shift; python3 scripts/check-sqlx-patch "$@" ;;
  native-model-host-sync) python3 scripts/test-configure-native-model-host.py ;;
  host-planner-scope) node scripts/test-host-planner-scope.mjs ;;
  host-mcp-origin) node scripts/test-host-mcp-origin.mjs ;;
  host-speech) node scripts/test-host-speech.mjs ;;
  host-speech-cycle) python3 scripts/test-host-speech-cycle ;;
  host-speech-defaults) python3 scripts/test-host-speech-defaults ;;
  local-whisper-preset) shift; python3 scripts/test-local-whisper-preset "$@" ;;
  host-voice-browser) shift; node scripts/test-host-voice-browser.mjs "$@" ;;
  host-planner) shift; python3 scripts/test-host-planner "$@" ;;
  planner-multiprocess) python3 scripts/test-planner-multiprocess ;;
  planner-env-routing) python3 scripts/test-planner-env-routing ;;
  host-coding) python3 scripts/test-host-coding ;;
  native-model-host) shift; python3 scripts/test-native-model-host "$@" ;;
  host-file-copilot) python3 scripts/test-host-file-copilot ;;
  host-coding-ui) shift; node scripts/test-host-coding-ui.mjs "$@" ;;
  host-coding-workflow) shift; python3 scripts/test-host-coding-workflow "$@" ;;
  shared-client-consumer) docker build --no-cache --target test --output=type=cacheonly validation/model-client-consumer ;;
  host-shared-client) shift; python3 scripts/test-shared-client-host "$@" ;;
  ui|staging)
    profile=worktree
    [[ $1 == staging ]] && profile=staging
    plan=$(bash scripts/env "$profile" plan)
    project=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["project"])' <<<"$plan")
    state=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["state"])' <<<"$plan")
    port=$(docker compose --project-name "$project" --project-directory "$root" --env-file "$state/environment.env" -f "deploy/compose.$profile.yaml" port app 8787)
    port=${port##*:}
    docker run --rm --env-file "$state/environment.env" -e "ARUVI_REMOTE_URL=http://host.docker.internal:$port" \
      -v "$root:/project:ro" -w /tmp/app mcr.microsoft.com/playwright:v1.58.2-noble sh -c '
        cp /project/package.json /project/package-lock.json /project/playwright.remote.config.js ./ &&
        cp -R /project/e2e-remote ./ && npm ci --silent &&
        npx playwright test -c playwright.remote.config.js remote.spec.js -g "remote UI connects and opens each operational section"
      '
    if [[ $profile == worktree ]]; then
      bash scripts/test-container-remote.sh
      bash scripts/test-container-ci.sh
      bash scripts/test-container-workflow.sh
    fi ;;
  *) printf '%s\n' 'Usage: scripts/test unit|integration|ui|staging|host-layout|model-routing|sqlx-patch|native-model-host-sync|host-planner-scope|host-mcp-origin|host-speech|host-speech-cycle|host-speech-defaults|local-whisper-preset|host-voice-browser|host-planner|planner-multiprocess|planner-env-routing|host-coding|native-model-host|host-coding-ui|host-file-copilot|host-coding-workflow|shared-client-consumer|host-shared-client' >&2; exit 2 ;;
esac
