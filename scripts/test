#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
case "${1:-}" in
  unit) npm run terminology-check && npm run unit-test && npm run test:frontend ;;
  integration) npm run integration-test ;;
  headless-shutdown) shift; python3 scripts/test-headless-shutdown.py "$@" ;;
  host-layout) node scripts/test-host-layout.mjs ;;
  model-routing) python3 scripts/test-model-routing.py ;;
  sqlx-patch) shift; python3 scripts/check-sqlx-patch "$@" ;;
  native-model-host-sync) python3 scripts/test-configure-native-model-host.py ;;
  native-bridge-bind) shift; python3 scripts/test-native-bridge-bind.py "$@" ;;
  native-bridge-tokens) shift; python3 scripts/test-native-bridge-tokens.py "$@" ;;
  native-general-copilot) node scripts/test-native-general-copilot.mjs ;;
  native-code-editor) node scripts/test-native-code-editor.mjs ;;
  native-bulk-import) node scripts/test-native-bulk-import.mjs ;;
  native-workspace-root-guard) node scripts/test-native-workspace-root-guard.mjs ;;
  native-workspace-edit) node scripts/test-native-workspace-edit.mjs ;;
  native-workspace-binary) node scripts/test-native-workspace-binary.mjs ;;
  native-planner-matches) node scripts/test-native-planner-matches.mjs ;;
  container-bridge-tokens) shift; python3 scripts/test-container-bridge-tokens.py "$@" ;;
  host-planner-scope) node scripts/test-host-planner-scope.mjs ;;
  host-bulk-import) node scripts/test-host-bulk-import.mjs ;;
  host-workspace-edit) node scripts/test-host-workspace-edit.mjs ;;
  host-mcp-origin) node scripts/test-host-mcp-origin.mjs ;;
  tls-mcp-proxy) node scripts/test-tls-mcp-proxy.mjs ;;
  environment-acceptance) shift; python3 scripts/test-environment-acceptance "$@" ;;
  database-override-multiprocess) python3 scripts/test-database-override-multiprocess.py ;;
  workspace-root-multiprocess) python3 scripts/test-workspace-root-multiprocess.py ;;
  docker-host-model) python3 scripts/test-docker-host-model.py ;;
  container-artifact-boundaries) python3 scripts/test-container-artifact-boundaries.py ;;
  remote-host-fixture) bash scripts/test-host-browser-fixture.sh remote ;;
  workflow-host-fixture) bash scripts/test-host-browser-fixture.sh workflow ;;
  ci-host-fixture) bash scripts/test-host-browser-fixture.sh ci ;;
  host-speech) node scripts/test-host-speech.mjs ;;
  host-speech-cycle) python3 scripts/test-host-speech-cycle ;;
  host-speech-defaults) python3 scripts/test-host-speech-defaults ;;
  speech-env-routing) python3 scripts/test-speech-env-routing ;;
  local-whisper-preset) shift; python3 scripts/test-local-whisper-preset "$@" ;;
  host-voice-browser) shift; node scripts/test-host-voice-browser.mjs "$@" ;;
  host-planner) shift; python3 scripts/test-host-planner "$@" ;;
  planner-multiprocess) python3 scripts/test-planner-multiprocess ;;
  workflow-transition-multiprocess) python3 scripts/test-workflow-transition-multiprocess.py ;;
  planner-env-routing) python3 scripts/test-planner-env-routing ;;
  host-coding) python3 scripts/test-host-coding ;;
  real-coding-review) python3 scripts/test-real-coding-review ;;
  native-model-host) shift; python3 scripts/test-native-model-host "$@" ;;
  native-ci-service) shift; python3 scripts/test-native-ci-service "$@" ;;
  native-database-override) shift; python3 scripts/test-native-database-override.py "$@" ;;
  ci-shared-worktree) python3 scripts/test-ci-shared-worktree.py ;;
  worktree-no-build) python3 scripts/test-worktree-no-build.py ;;
  host-file-copilot) python3 scripts/test-host-file-copilot ;;
  host-coding-ui) shift; node scripts/test-host-coding-ui.mjs "$@" ;;
  host-coding-workflow) shift; python3 scripts/test-host-coding-workflow "$@" ;;
  shared-client-package)
    manifest="$root/crates/aruvi-model-client/Cargo.toml"
    metadata=$(cargo metadata --manifest-path "$manifest" --offline --no-deps --format-version 1)
    target_dir=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])' <<<"$metadata")
    version=$(python3 -c 'import json,sys; print(next(p["version"] for p in json.load(sys.stdin)["packages"] if p["name"] == "aruvi-model-client"))' <<<"$metadata")
    cargo package --manifest-path "$manifest" --offline --allow-dirty
    cargo test --manifest-path "$target_dir/package/aruvi-model-client-$version/Cargo.toml" --offline --locked ;;
  shared-client-pin) python3 scripts/test-model-client-pin.py && python3 scripts/check-model-client-pin.py ;;
  shared-client-consumer) python3 scripts/test-model-client-pin.py && python3 scripts/check-model-client-pin.py && docker build --no-cache --target test --output=type=cacheonly validation/model-client-consumer ;;
  host-shared-client) shift; python3 scripts/test-shared-client-host "$@" ;;
  scoped-real-host) shift; python3 scripts/test-scoped-real-host "$@" ;;
  ui|integration-ui|staging)
    profile=worktree
    [[ $1 == staging ]] && profile=staging
    [[ $1 == integration-ui ]] && profile=integration
    plan=$(bash scripts/env "$profile" plan)
    project=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["project"])' <<<"$plan")
    state=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["state"])' <<<"$plan")
    port=$(docker compose --project-name "$project" --project-directory "$root" --env-file "$state/environment.env" -f "deploy/compose.$profile.yaml" port app 8787)
    port=${port##*:}
    # Rootless Docker's host network may be isolated from host loopback. Check
    # publication from the host, then use the actual Compose network for the
    # browser. This does not test external ingress or browser-origin MCP.
    python3 - "$port" <<'PY'
import sys, urllib.request
with urllib.request.urlopen('http://127.0.0.1:' + sys.argv[1] + '/health', timeout=10) as response:
    if response.status != 200:
        raise SystemExit('Published app health check failed')
PY
    docker run --rm --network "${project}_default" --env-file "$state/environment.env" -e "ARUVI_REMOTE_URL=http://app:8787" \
      -v "$root:/project:ro" -w /tmp/app mcr.microsoft.com/playwright:v1.58.2-noble sh -c '
        cp /project/package.json /project/package-lock.json /project/playwright.remote.config.js ./ &&
        cp -R /project/e2e-remote ./ && npm ci --silent &&
        npx playwright test -c playwright.remote.config.js remote.spec.js -g "remote UI connects and opens each operational section"
      '
    if [[ $profile == worktree ]]; then
      bash scripts/test-container-remote.sh
      bash scripts/test-container-ci.sh
      bash scripts/test-container-workflow.sh
    fi ;;
  *) printf '%s\n' 'Usage: scripts/test unit|integration|headless-shutdown|ui|integration-ui|staging|environment-acceptance|database-override-multiprocess|workspace-root-multiprocess|docker-host-model|container-artifact-boundaries|remote-host-fixture|workflow-host-fixture|ci-host-fixture|host-layout|model-routing|sqlx-patch|native-model-host-sync|native-bridge-bind|native-bridge-tokens|native-general-copilot|native-code-editor|native-bulk-import|native-workspace-root-guard|native-workspace-edit|native-workspace-binary|native-planner-matches|container-bridge-tokens|host-planner-scope|host-bulk-import|host-workspace-edit|host-mcp-origin|tls-mcp-proxy|host-speech|host-speech-cycle|host-speech-defaults|speech-env-routing|local-whisper-preset|host-voice-browser|host-planner|planner-multiprocess|workflow-transition-multiprocess|planner-env-routing|host-coding|real-coding-review|native-model-host|native-ci-service|native-database-override|ci-shared-worktree|worktree-no-build|host-coding-ui|host-file-copilot|host-coding-workflow|shared-client-package|shared-client-pin|shared-client-consumer|host-shared-client|scoped-real-host' >&2; exit 2 ;;
esac
