#!/usr/bin/env python3
"""Exercise an isolated environment's product, MCP, export and optional restart."""
import argparse
import json
import re
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('profile', choices=('worktree', 'integration', 'staging'))
parser.add_argument('--restart', action='store_true', help='Restart this environment and verify the test product persists')
parser.add_argument('--expected-image-id', help='Expected full sha256 Docker image ID for both services')
args = parser.parse_args()
product_id = None
cleanup_error = None
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

def command(argv):
    return subprocess.check_output(argv, cwd=root, text=True).strip()

try:
    plan = json.loads(command(['bash', 'scripts/env', args.profile, 'plan']))
    env_file = Path(plan['state']) / 'environment.env'
    values = dict(line.split('=', 1) for line in env_file.read_text().splitlines() if line and not line.startswith('#') and '=' in line)
    mobile_token, mcp_token = values['ARUVI_MOBILE_API_TOKEN'], values['ARUVI_MCP_API_TOKEN']
    if not mobile_token.strip() or not mcp_token.strip(): raise ValueError('Environment tokens are missing')
    compose = ['docker', 'compose', '--project-name', plan['project'], '--project-directory', str(root), '--env-file', str(env_file), '-f', str(root / f'deploy/compose.{args.profile}.yaml')]
    def endpoint():
        address = command(compose + ['port', 'app', '8787']).splitlines()[0]
        if not address.startswith('127.0.0.1:') or not address.removeprefix('127.0.0.1:').isdigit():
            raise ValueError('Expected an IPv4 loopback-only published endpoint')
        return 'http://' + address
    base = endpoint()
    if args.expected_image_id and not re.fullmatch(r'sha256:[0-9a-f]{64}', args.expected_image_id):
        raise ValueError('Expected a full lowercase sha256 Docker image ID')

    def check_image_identity():
        image_ids = []
        for service in ('app', 'pdf'):
            identifier = command(compose + ['ps', '-q', service])
            if not identifier: raise ValueError(service + ' service container is unavailable')
            image_ids.append(command(['docker', 'inspect', '--format', '{{.Image}}', identifier]))
        if image_ids[0] != image_ids[1]: raise ValueError('App and PDF services use different image IDs')
        if args.expected_image_id and image_ids[0] != args.expected_image_id:
            raise ValueError('Running image ID does not match the expected image ID')
        print('Running app and PDF image ID: ' + image_ids[0], flush=True)
        if not args.expected_image_id:
            print('Image identity was observed but not checked against an expected ID.', flush=True)

    check_image_identity()

    def request(path, token=None, body=None, timeout=30):
        headers = {'Accept': 'application/json'}
        if token: headers['Authorization'] = 'Bearer ' + token
        if body is not None: headers['Content-Type'] = 'application/json'
        req = urllib.request.Request(base + path, headers=headers, data=json.dumps(body).encode() if body is not None else None)
        return opener.open(req, timeout=timeout)

    def mcp(tool, action, arguments):
        payload = {'jsonrpc': '2.0', 'id': 1, 'method': 'tools/call', 'params': {'name': tool, 'arguments': {'action': action, 'arguments': arguments}}}
        with request('/api/mcp', mcp_token, payload) as response: data = json.load(response)
        if data.get('error') or data.get('result', {}).get('isError'): raise ValueError('MCP action failed: ' + action)
        return data['result']['structuredContent']['result']

    def check_product():
        if mcp('aruvi_catalog', 'get_product', {'id': product_id})['name'] != name: raise ValueError('MCP product read did not match')
        with request('/api/mobile/products', mobile_token) as response: products = json.load(response)
        if not any(item['id'] == product_id and item['name'] == name for item in products): raise ValueError('Mobile product listing did not match')
        with request('/api/mobile/products/' + product_id + '/book-export', mobile_token, {'format': 'pdf', 'trim_preset': 'a5'}, timeout=90) as response:
            if response.headers.get_content_type() != 'application/pdf' or response.read(5) != b'%PDF-': raise ValueError('Product PDF export failed')

    with request('/health') as response:
        if response.status != 200: raise ValueError('Health check failed')
    for path in ('/api/mobile/products',):
        try:
            with request(path): raise ValueError('Unauthenticated mobile request unexpectedly succeeded')
        except urllib.error.HTTPError as error:
            if error.code != 401: raise
    name = 'Environment acceptance fixture ' + uuid.uuid4().hex
    product_id = mcp('aruvi_catalog', 'create_product', {'name': name, 'tags': ['environment_acceptance_fixture']})['id']
    print('Created acceptance fixture product ' + product_id, flush=True)
    mcp('aruvi_catalog', 'create_product_area', {'product_id': product_id, 'name': 'Acceptance area'})
    mcp('aruvi_work_items', 'create_work_item', {'product_id': product_id, 'title': 'Acceptance task', 'work_item_type': 'task'})
    check_product()
    if args.restart:
        subprocess.run(compose + ['restart', 'app', 'pdf'], cwd=root, check=True, stdout=subprocess.DEVNULL)
        deadline = time.monotonic() + 90
        while True:
            try:
                base = endpoint()
                ids = [command(compose + ['ps', '-q', service]) for service in ('app', 'pdf')]
                if not all(ids): raise ValueError('Service container unavailable')
                statuses = [command(['docker', 'inspect', '--format', '{{.State.Health.Status}}', identifier]) for identifier in ids]
                if statuses != ['healthy', 'healthy']: raise ValueError('Services not healthy yet')
                with request('/health', timeout=2) as response:
                    if response.status == 200: break
            except (OSError, ValueError, IndexError, subprocess.CalledProcessError, urllib.error.URLError): pass
            if time.monotonic() >= deadline: raise ValueError('Environment did not become healthy after restart')
            time.sleep(.5)
        check_image_identity()
        check_product()
    print('Environment product, MCP, mobile authorization and PDF checks passed' + (' after restart' if args.restart else '') + '.')
except (OSError, KeyError, ValueError, subprocess.SubprocessError, urllib.error.URLError) as error:
    print('Environment acceptance failed: ' + type(error).__name__ + ': ' + (str(error) if isinstance(error, ValueError) else 'request or environment operation failed'), file=sys.stderr)
    sys.exit(1)
finally:
    if product_id:
        try:
            base = endpoint()
            mcp('aruvi_catalog', 'archive_product', {'id': product_id})
            print('Archived acceptance fixture product ' + product_id)
        except Exception:
            print('Could not archive acceptance fixture product ' + product_id, file=sys.stderr)
            cleanup_error = True
    if cleanup_error: sys.exit(1)
