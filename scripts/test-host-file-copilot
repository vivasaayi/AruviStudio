#!/usr/bin/env python3
"""Test file-aware Copilot against Model Host in a disposable Studio fixture."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.request

root = Path(__file__).resolve().parent.parent
host = root.parent / "aruvi-model-host-studio-validation"
container = volume = None
container_created = volume_owned = False

def command(argv, **kwargs):
    return subprocess.check_output(argv, text=True, **kwargs).strip()

def environment(path):
    return dict(line.split("=", 1) for line in path.read_text().splitlines() if line and not line.startswith("#") and "=" in line)

try:
    studio = json.loads(command(["bash", "scripts/env", "worktree", "plan"], cwd=root))
    envfile = Path(studio["state"]) / "environment.env"
    native_env = dict(os.environ, ARUVI_MODEL_HOST_ENV="native")
    host_plan = json.loads(command(["bash", "scripts/env", "worktree", "plan"], cwd=host, env=native_env))
    host_status = json.loads(command(["bash", "scripts/env", "worktree", "status"], cwd=host, env=native_env))
    host_url = host_status["endpoint"]["url"]
    if not host_status["registered"] or not host_url.startswith("http://127.0.0.1:"):
        raise ValueError("Expected a running loopback native host worktree")
    token = environment(Path(host_plan["state"]) / "environment.env")["MODEL_HOST_TOKEN"]
    port = int(host_url.rsplit(":", 1)[1])
    container = f'{studio["project"]}-file-copilot-{os.getpid()}'
    volume = f'{studio["project"]}_file_copilot_socket_{os.getpid()}'
    for kind, name in [("container", container), ("volume", volume)]:
        if subprocess.run(["docker", kind, "inspect", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            raise ValueError(f"Disposable {kind} name already exists")
    volume_owned = True
    compose_env = dict(os.environ, APP_IMAGE=environment(envfile)["APP_IMAGE"], PRODUCT_SOURCE=str(root), TEST_SOCKET_NAME=volume, COMPOSE_IGNORE_ORPHANS="true")
    compose = ["docker", "compose", "--project-name", studio["project"], "--project-directory", str(root), "--env-file", str(envfile), "-f", str(root / "deploy/compose.test.yaml")]
    command(compose + ["run", "--rm", "-d", "--name", container, "-p", "127.0.0.1::8787", "fixture"], env=compose_env)
    container_created = True
    subprocess.run(["docker", "exec", "-i", container, "sh", "-c", "umask 077; cat > /data/llm-config.json"], input=json.dumps({"refs": {"coding-fixture": token}}), text=True, check=True)
    command(["docker", "exec", container, "sh", "-c", "mkdir -p /repositories/copilot-fixture && git init -q /repositories/copilot-fixture && printf 'function multiplyBySeven(x) { return x * 7; }\\n' > /repositories/copilot-fixture/math.js"])
    address = command(["docker", "port", container, "8787/tcp"]).splitlines()[0]
    if not address.startswith("127.0.0.1:"):
        raise ValueError("Fixture endpoint is not loopback-only")
    deadline = time.monotonic() + 30
    while True:
        try:
            with urllib.request.urlopen(f"http://{address}/health", timeout=2) as response:
                if response.status == 200: break
        except (OSError, urllib.error.URLError):
            if time.monotonic() >= deadline: raise ValueError("Studio fixture did not become healthy")
            time.sleep(0.25)
    def post(path, payload, bearer):
        request = urllib.request.Request(f"http://{address}{path}", data=json.dumps(payload).encode(), headers={"Authorization": "Bearer " + bearer, "Content-Type": "application/json", "Accept": "application/json"})
        with urllib.request.urlopen(request, timeout=240) as response: return json.load(response)
    def mcp(tool, action, arguments):
        result = post("/api/mcp", {"jsonrpc":"2.0", "id":1, "method":"tools/call", "params":{"name":tool,"arguments":{"action":action,"arguments":arguments}}}, "workflow-mcp-test")["result"]
        if result.get("isError"): raise ValueError("Fixture MCP action failed: " + action + ": " + json.dumps(result.get("content", []))[:1000])
        return result["structuredContent"]["result"]
    provider = mcp("aruvi_models", "create_provider", {"name":"File Copilot fixture", "base_url":f"http://host.docker.internal:{port}/v1", "auth_secret_ref":"ref:coding-fixture"})
    repo = mcp("aruvi_repositories", "register_repository", {"name":"File fixture", "local_path":"/repositories/copilot-fixture", "default_branch":"main"})
    file = post("/api/mobile/repository-inspect", {"action":"read_repository_file", "repository_id":repo["id"], "relative_path":"math.js"}, "workflow-mobile-test")
    model = os.environ.get("ARUVI_CODING_TEST_MODEL", "qwen25-coder-7b-q4")
    payload = {"repository_id":repo["id"], "relative_path":"math.js", "expected_sha256":file["sha256"], "provider_id":provider["id"], "model_name":model, "question":"Name the function defined in this file."}
    answer = post("/api/mobile/repository-file/copilot", payload, "workflow-mobile-test")
    if "multiplybyseven" not in answer.get("content", "").lower():
        raise ValueError("Model response did not identify the fixture function")
    followup = dict(payload, history=[{"role":"user","content":payload["question"]}, {"role":"assistant","content":answer["content"]}], question="What number does it multiply by? Reply with the number.")
    answer = post("/api/mobile/repository-file/copilot", followup, "workflow-mobile-test")
    if "7" not in answer.get("content", ""):
        raise ValueError("Model follow-up did not identify the multiplier")
    answer = mcp("aruvi_models", "run_file_copilot", followup)
    if "7" not in answer.get("content", ""): raise ValueError("MCP model follow-up did not identify the multiplier")
    proposal_request = dict(payload, question="Change the function to multiply by 9 instead of 7. Keep its name. Return a single patch for math.js.", patch_mode=True)
    for interface in ("web", "mcp"):
        if interface == "web":
            answer = post("/api/mobile/repository-file/copilot", proposal_request, "workflow-mobile-test")
        else:
            answer = mcp("aruvi_models", "run_file_copilot", proposal_request)
        content = answer.get("content", "").strip()
        if content.startswith("```"):
            content = "\n".join(content.splitlines()[1:-1])
        try:
            proposal = json.loads(content)
        except json.JSONDecodeError as error:
            raise ValueError(f"{interface} proposal was not JSON: {content[:800]}") from error
        if proposal.get("type") != "patch_proposal" or len(proposal.get("patches", [])) != 1 or proposal["patches"][0].get("path") != "math.js":
            raise ValueError(f"{interface} proposal had an unexpected shape: {content[:800]}")
        patch = proposal["patches"][0]["patch"]
        args = {"repository_id": repo["id"], "relative_path": "math.js", "patch": patch, "base_sha256": file["sha256"]}
        try:
            preview = post("/api/mobile/repository-inspect", dict(args, action="preview_repository_patch"), "workflow-mobile-test") if interface == "web" else mcp("aruvi_repositories", "preview_repository_patch", args)
        except (ValueError, urllib.error.HTTPError) as error:
            raise ValueError(f"{interface} proposal failed preview: {content[:800]} ({error})") from error
        if "x * 9" not in preview["result_content"] or "multiplyBySeven" not in preview["result_content"]:
            raise ValueError(f"{interface} proposal did not implement the requested change: {content[:800]}")
        if mcp("aruvi_repositories", "read_repository_file", {"repository_id": repo["id"], "relative_path": "math.js"})["content"] != file["content"]:
            raise ValueError("Preview modified the fixture")
        if interface == "web":
            post("/api/mobile/repository-inspect", dict(args, action="apply_reviewed_repository_patch", expected_exists=True), "workflow-mobile-test")
        else:
            mcp("aruvi_repositories", "apply_reviewed_repository_patch", dict(args, expected_exists=True))
        applied = mcp("aruvi_repositories", "read_repository_file", {"repository_id": repo["id"], "relative_path": "math.js"})["content"]
        if applied != preview["result_content"]: raise ValueError("Applied file did not match preview")
        mcp("aruvi_repositories", "write_repository_file", {"repository_id":repo["id"], "relative_path":"math.js", "content":file["content"]})
        print(f"Real {model} {interface} patch proposal was previewed and applied successfully")
    print(f"Real {model} file-context Copilot follow-ups passed through web and MCP in a disposable fixture")
except (OSError, KeyError, TypeError, ValueError, subprocess.SubprocessError) as error:
    print(f"File Copilot fixture failed: {type(error).__name__}: {error if not isinstance(error, subprocess.CalledProcessError) else 'fixture command failed'}", file=sys.stderr)
    sys.exit(1)
finally:
    if container_created: subprocess.run(["docker", "rm", "-f", container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if volume_owned: subprocess.run(["docker", "volume", "rm", volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
