#!/usr/bin/env python3
"""Check a disposable native Studio server against a real, empty Aruvici service."""
import argparse
import contextlib
import fcntl
import hashlib
import json
import os
from pathlib import Path
import secrets
import socket
import sqlite3
import subprocess
import tempfile
import time
import urllib.error
import urllib.request

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("studio_binary", type=Path)
parser.add_argument("aruvici_binary", type=Path)
parser.add_argument("--docker-image", help="Optionally probe the temporary socket from this local image as UID 10001")
parser.add_argument("--audit-protocol", action="store_true", help="Inspect a disposable target and report protocol support without queueing a build")
parser.add_argument("--exercise-protocol", action="store_true", help="With --audit-protocol, verify retry and artifact records with worker execution locked")
parser.add_argument("--execute-build", action="store_true", help="With --audit-protocol, execute a disposable Rust/OCI build")
args = parser.parse_args()
if (args.exercise_protocol or args.execute_build) and not args.audit_protocol:
    parser.error("--exercise-protocol and --execute-build require --audit-protocol")
if args.exercise_protocol and args.execute_build:
    parser.error("Choose either --exercise-protocol or --execute-build")
studio = args.studio_binary.resolve(strict=True)
aruvici = args.aruvici_binary.resolve(strict=True)

def stop(process):
    if process and process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()

def wait_for(predicate, processes):
    deadline = time.monotonic() + 45
    while time.monotonic() < deadline:
        if any(process.poll() is not None for process in processes):
            raise RuntimeError("A disposable service exited before becoming ready")
        try:
            if predicate(): return
        except (OSError, urllib.error.URLError):
            pass
        time.sleep(0.2)
    raise RuntimeError("Disposable service did not become ready")

ci = app = None
try:
    with tempfile.TemporaryDirectory(prefix="aruvi-ci-check-", dir="/private/tmp") as temp, contextlib.ExitStack() as cleanup:
        root = Path(temp)
        state = root / "ci"
        state.mkdir(mode=0o700)
        platform = root / "platform.toml"
        repository = root / "repository"
        repository.mkdir()
        config = 'state_dir = ' + json.dumps(str(state)) + '\n'
        if args.audit_protocol:
            profile = "rust-docker@1" if args.exercise_protocol or args.execute_build else "native-ios@1"
            config += '[[targets]]\nid = "fixture"\nrepository = ' + json.dumps(str(repository)) + '\nprofile = ' + json.dumps(profile) + '\n'
        if args.exercise_protocol or args.execute_build:
            (repository / "Cargo.toml").write_text("[package]\nname='fixture'\nversion='0.1.0'\n")
            (repository / "Dockerfile").write_text("FROM scratch\n" + ("COPY fixture.txt /fixture.txt\n" if args.execute_build else ""))
            if args.execute_build:
                (repository / "src").mkdir()
                (repository / "src/lib.rs").write_text("pub fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n")
                (repository / "fixture.txt").write_text("Disposable CI fixture\n")
                subprocess.run(["cargo", "generate-lockfile", "--offline"], cwd=repository, check=True, capture_output=True)
            def git(*arguments):
                return subprocess.run(["git", *arguments], cwd=repository, check=True, capture_output=True, text=True).stdout.strip()
            git("init", "-q")
            git("add", ".")
            git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "fixture")
            commit = git("rev-parse", "HEAD")
            if args.exercise_protocol:
                locks = state / "locks"
                locks.mkdir()
                release_lock = cleanup.enter_context((locks / "release.lock").open("w"))
                fcntl.flock(release_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if not args.audit_protocol:
            config += 'targets = []\n'
        platform.write_text(config)
        base_env = {key: value for key, value in os.environ.items() if not key.startswith("ARUVI_")}
        ci = subprocess.Popen([str(aruvici), "ci", "--platform", str(platform), "serve"], env=base_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cleanup.callback(stop, ci)
        ci_socket = state / "ci.sock"
        def ci_ready():
            with socket.socket(socket.AF_UNIX) as connection:
                connection.settimeout(2)
                connection.connect(str(ci_socket))
                connection.sendall(b'{"method":"health"}\n')
                return json.loads(connection.makefile("rb").readline())["ok"]
        wait_for(ci_ready, [ci])
        with socket.socket() as reserve:
            reserve.bind(("127.0.0.1", 0))
            port = reserve.getsockname()[1]
        token = secrets.token_urlsafe(32)
        env = dict(base_env, ARUVI_APP_DATA_DIR=str(root / "studio"), ARUVI_DB_PATH=str(root / "studio.db"),
                   ARUVI_LLM_CONFIG_PATH=str(root / "llm-config.json"), ARUVI_CI_SOCKET=str(ci_socket),
                   ARUVI_WEBHOOK_HOST="127.0.0.1", ARUVI_WEBHOOK_PORT=str(port),
                   ARUVI_MOBILE_API_TOKEN=token, ARUVI_MCP_API_TOKEN=token)
        app = subprocess.Popen([str(studio)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cleanup.callback(stop, app)
        address = f"http://127.0.0.1:{port}"
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        def health():
            owners = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True, check=False).stdout.split()
            if str(app.pid) not in owners: return False
            with opener.open(address + "/health", timeout=2) as response: return response.status == 200
        wait_for(health, [ci, app])
        def mcp_result(tool, action, arguments=None):
            payload = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": tool, "arguments": {"action": action, "arguments": arguments or {}}}}
            request = urllib.request.Request(address + "/api/mcp", data=json.dumps(payload).encode(), headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
            with opener.open(request, timeout=10) as response: result = json.load(response)["result"]
            return result
        def call(tool, action, arguments=None):
            result = mcp_result(tool, action, arguments)
            if result.get("isError"): raise RuntimeError("MCP CI action failed: " + action)
            return result["structuredContent"]["result"]
        status = call("aruvi_ci", "get_status")
        if status.get("status") != "online" or status.get("protocol") != 1: raise RuntimeError("Unexpected CI health response")
        targets = call("aruvi_ci", "list_targets")
        if len(targets) != (1 if args.audit_protocol else 0) or call("aruvi_ci", "list_runs") != []: raise RuntimeError("Unexpected disposable CI registry")
        request = urllib.request.Request(address + "/api/mobile/ci/status", headers={"Authorization": "Bearer " + token})
        with opener.open(request, timeout=10) as response: mobile = json.load(response)
        if mobile.get("status") != "online" or mobile.get("protocol") != 1: raise RuntimeError("Unexpected browser CI health response")
        print("Disposable native Studio and Aruvici: MCP health, targets, runs and browser API health passed.")
        if args.audit_protocol:
            product = call("aruvi_catalog", "create_product", {"name": "CI protocol fixture"})
            repo = call("aruvi_repositories", "register_repository", {"name": "CI fixture", "local_path": str(repository)})
            call("aruvi_repositories", "attach_repository", {"scope_type": "product", "scope_id": product["id"], "repository_id": repo["id"]})
            binding = mcp_result("aruvi_ci", "save_binding", {"product_id": product["id"], "repository_id": repo["id"], "target_id": "fixture"})
            detail = json.dumps(binding.get("content", []))
            if binding.get("isError") and "no repository metadata" in detail:
                print("Protocol gap: target listing omits repository metadata; Studio rejects binding.")
            elif binding.get("isError"):
                raise RuntimeError("Unexpected target binding failure")
            else:
                print("Target repository metadata and binding are supported.")
            if args.exercise_protocol:
                cli = [str(aruvici), "ci", "--platform", str(platform)]
                plan = json.loads(subprocess.run(cli + ["plan", "fixture"], check=True, capture_output=True, text=True).stdout)
                if plan["issues"]: raise RuntimeError("Disposable target is not buildable")
                subprocess.run(cli + ["approve", "fixture", "--digest", plan["digest"]], check=True, capture_output=True, text=True)
                artifact_bytes = b"disposable CI artifact"
                run_root = state / "ci-runs" / "1"
                run_root.mkdir(parents=True)
                artifact_path = run_root / "package.bin"
                artifact_path.write_bytes(artifact_bytes)
                with sqlite3.connect(state / "ci.sqlite") as database:
                    database.execute("INSERT INTO runs(id,target,commit_hash,plan_digest,dedupe_key,context,status) VALUES (1,?,?,?,?,?,?)", ("fixture", commit, plan["digest"], "original", json.dumps({"fixture": True}), "failed"))
                    database.execute("INSERT INTO artifacts(id,run_id,stage,kind,path,sha256,size) VALUES (1,1,?,?,?,?,?)", ("package", "package", str(artifact_path), hashlib.sha256(artifact_bytes).hexdigest(), len(artifact_bytes)))
                readiness = call("aruvi_ci", "artifact_readiness", {"id": 1})
                if readiness.get("sha256") != hashlib.sha256(artifact_bytes).hexdigest() or readiness.get("eligible") is not False:
                    raise RuntimeError("Unexpected artifact verification")
                try:
                    opener.open(address + "/api/mobile/ci/artifacts/1/readiness", timeout=10)
                    raise RuntimeError("Unauthenticated artifact verification was accepted")
                except urllib.error.HTTPError as error:
                    if error.code != 401: raise
                request = urllib.request.Request(address + "/api/mobile/ci/artifacts/1/readiness", headers={"Authorization": "Bearer " + token})
                with opener.open(request, timeout=10) as response: browser_readiness = json.load(response)
                if browser_readiness != readiness: raise RuntimeError("Browser and MCP artifact verification differ")
                artifact_path.write_bytes(b"tampered")
                if not mcp_result("aruvi_ci", "artifact_readiness", {"id": 1}).get("isError"):
                    raise RuntimeError("Tampered artifact was accepted")
                retry = call("aruvi_ci", "retry_run", {"id": 1})
                retried = call("aruvi_ci", "get_run", {"id": retry["run_id"]})
                if retried.get("status") != "queued" or retried.get("commit") != commit or retried.get("context") != {"fixture": True}:
                    raise RuntimeError("Retry lost its provenance or was executed")
                print("MCP artifact integrity and guarded retry passed; worker execution remained locked.")
            if args.execute_build:
                cli = [str(aruvici), "ci", "--platform", str(platform)]
                plan = json.loads(subprocess.run(cli + ["plan", "fixture"], check=True, capture_output=True, text=True).stdout)
                if plan["issues"]: raise RuntimeError("Disposable target is not buildable")
                subprocess.run(cli + ["approve", "fixture", "--digest", plan["digest"]], check=True, capture_output=True, text=True)
                queued = call("aruvi_ci", "queue_build", {"target_id": "fixture", "repository_id": repo["id"], "product_id": product["id"], "commit": commit})
                run_id = queued["run_id"]
                deadline = time.monotonic() + 300
                while True:
                    run = call("aruvi_ci", "get_run", {"id": run_id})
                    if run["status"] in ("passed", "failed", "blocked", "cancelled", "interrupted"): break
                    if time.monotonic() >= deadline: raise RuntimeError("Disposable build did not finish")
                    time.sleep(.5)
                if run["status"] != "passed":
                    raise RuntimeError("Disposable build did not pass: " + json.dumps({"status":run["status"], "stages":run.get("stages", []), "error":run.get("error")}))
                stages = {stage["name"]: stage["status"] for stage in run.get("stages", [])}
                if any(stages.get(stage) != "passed" for stage in ("secrets", "fmt", "clippy", "rust-tests", "package", "verify-package")):
                    raise RuntimeError("Disposable build did not pass all expected stages: " + json.dumps(stages))
                artifacts = [item for item in run.get("artifacts", []) if item.get("kind") == "package"]
                if len(artifacts) != 1: raise RuntimeError("Expected one OCI package artifact")
                readiness = call("aruvi_ci", "artifact_readiness", {"id": artifacts[0]["id"]})
                if readiness.get("run_id") != run_id or readiness.get("eligible") is not False:
                    raise RuntimeError("Unexpected OCI artifact verification")
                request = urllib.request.Request(address + "/api/mobile/ci/runs/" + str(run_id), headers={"Authorization": "Bearer " + token})
                with opener.open(request, timeout=10) as response: browser_run = json.load(response)
                if browser_run.get("status") != "passed" or browser_run.get("commit") != commit:
                    raise RuntimeError("Browser API did not report the completed build")
                print("Disposable real CI build passed through MCP and browser API; OCI artifact integrity verified.")
            for action in (() if args.exercise_protocol or args.execute_build else ("retry_run", "artifact_readiness")):
                result = mcp_result("aruvi_ci", action, {"id": 1})
                if result.get("isError") and "unsupported method" in json.dumps(result.get("content", [])):
                    print("Protocol gap: " + action + " is unsupported by the service.")
                elif result.get("isError"):
                    print("Protocol result indeterminate for " + action + ": service returned an error.")
                else:
                    print("Protocol action succeeded: " + action + ".")
        if args.docker_image:
            probe = """const net=require('net');const s=net.connect('/ci/ci.sock');
s.setTimeout(3000);s.on('connect',()=>s.write('{\"method\":\"health\"}\\n'));
let b='';s.on('data',c=>{b+=c;if(b.includes('\\n')){try{const r=JSON.parse(b.split('\\n')[0]);if(r.ok&&r.result.status==='online'){console.log('connected');process.exit(0)}}catch{}process.exit(2)}});
s.on('timeout',()=>{console.log('unavailable:timeout');process.exit(3)});
s.on('error',e=>{console.log('unavailable:'+(e.code||'unknown'));process.exit(3)});"""
            result = subprocess.run(["docker", "run", "--rm", "--network", "none", "--read-only", "--cap-drop", "ALL", "--user", "10001:10001", "--security-opt", "no-new-privileges", "--mount", f"type=bind,src={state},dst=/ci,readonly", "--entrypoint", "/usr/local/bin/node", args.docker_image, "-e", probe], capture_output=True, text=True, timeout=30)
            outcome = result.stdout.strip()
            if result.returncode == 0 and outcome == "connected": print("Docker socket probe: connected as UID 10001.")
            elif result.returncode == 3 and outcome.startswith("unavailable:"): print("Docker socket probe: " + outcome)
            else: raise RuntimeError("Docker socket probe could not run")
        stop(app); app = None
        stop(ci); ci = None
finally:
    stop(app)
    stop(ci)
