#!/usr/bin/env python3
"""Opt-in loopback relay to a private Aruvici Unix socket."""
import argparse
import hmac
import json
import os
from pathlib import Path
import socket
import socketserver
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--socket', required=True, type=Path, help='Absolute path to the private Aruvici socket')
parser.add_argument('--port', type=int, default=0, help='Host loopback port (0 selects an available port)')
args = parser.parse_args()
token = os.environ.get('ARUVI_CI_RELAY_TOKEN', '')
if not args.socket.is_absolute() or not 0 <= args.port <= 65535:
    parser.error('An absolute socket path and valid port are required')
if not 32 <= len(token.encode()) <= 1024 or any(ord(c) < 32 or ord(c) == 127 for c in token):
    parser.error('ARUVI_CI_RELAY_TOKEN must contain 32 to 1024 bytes without control characters')
allowed = {'health', 'targets', 'plan', 'runs', 'run', 'events', 'enqueue', 'cancel', 'artifact', 'artifact_chunk', 'artifact_chunk_base64', 'logs', 'retry', 'promotion_readiness'}

class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        self.connection.settimeout(5)
        try:
            line = self.rfile.readline(65538)
            if len(line) > 65536 or not line.endswith(b'\n'): raise ValueError('invalid request')
            envelope = json.loads(line)
            candidate = envelope.get('token') if isinstance(envelope, dict) else None
            request = envelope.get('request') if isinstance(envelope, dict) else None
            if not isinstance(candidate, str) or not hmac.compare_digest(candidate.encode(), token.encode()):
                raise ValueError('authorization failed')
            if not isinstance(request, dict) or request.get('method') not in allowed:
                raise ValueError('unsupported request')
            payload = json.dumps(request, separators=(',', ':')).encode() + b'\n'
            if len(payload) > 65536: raise ValueError('invalid request')
            with socket.socket(socket.AF_UNIX) as upstream:
                upstream.settimeout(5)
                upstream.connect(str(args.socket))
                upstream.sendall(payload)
                data = bytearray()
                while True:
                    block = upstream.recv(65536)
                    if not block: break
                    data.extend(block)
                    if len(data) > 4 * 1024 * 1024: raise ValueError('response too large')
            response = json.loads(data)
            self.wfile.write(json.dumps(response, separators=(',', ':')).encode() + b'\n')
        except (OSError, ValueError, UnicodeError, TypeError):
            try: self.wfile.write(b'{"ok":false,"error":"CI relay request rejected or unavailable"}\n')
            except OSError: pass

class Server(socketserver.TCPServer):
    allow_reuse_address = False

try:
    with Server(('127.0.0.1', args.port), Handler) as server:
        print('CI relay listening on 127.0.0.1:' + str(server.server_address[1]), flush=True)
        server.serve_forever()
except OSError:
    print('CI relay could not start', file=sys.stderr)
    sys.exit(1)
