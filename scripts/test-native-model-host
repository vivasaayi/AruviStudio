#!/usr/bin/env python3
"""Run an isolated native Studio server and call a native Model Host through MCP."""
import argparse
import base64
import contextlib
from difflib import SequenceMatcher
import importlib.machinery
import io
import json
import os
from pathlib import Path
import secrets
import socket
import subprocess
import sys
import tempfile
import time
import re
import urllib.error
import urllib.request
import wave

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("binary", type=Path, help="Built native aruvi-studio-server binary")
parser.add_argument("host_worktree", type=Path, help="Running native Model Host worktree")
parser.add_argument("--model", required=True, help="Installed text model ID")
parser.add_argument("--speech-host", type=Path, help="Optional native Model Host checkout for speech")
parser.add_argument("--speech-environment", choices=("worktree", "integration", "staging"), default="staging")
parser.add_argument("--voice-model", default="piper-ljspeech")
parser.add_argument("--transcription-model", default="whisper-tiny-metal")
args = parser.parse_args()
class CheckError(ValueError):
    pass

process = None
def stop_process(child):
    if child.poll() is None:
        child.terminate()
        try: child.wait(timeout=10)
        except subprocess.TimeoutExpired: child.kill(); child.wait()

try:
    binary = args.binary.expanduser().resolve(strict=True)
    host = args.host_worktree.expanduser().resolve(strict=True)
    config = importlib.machinery.SourceFileLoader("host_config", str(root / "scripts/configure-native-model-host")).load_module()
    host_port, host_token = config.read_host(host, "worktree")
    speech = config.read_host(args.speech_host.expanduser().resolve(strict=True), args.speech_environment) if args.speech_host else None
    with tempfile.TemporaryDirectory(prefix="aruvi-native-validation-") as temporary, contextlib.ExitStack() as process_cleanup:
        data = Path(temporary)
        reference = "native-check-" + secrets.token_hex(16)
        speech_reference = "native-speech-" + secrets.token_hex(16)
        credential_file = data / "llm-config.json"
        refs = {reference: host_token}
        if speech: refs[speech_reference] = speech[1]
        credential_file.write_text(json.dumps({"refs": refs}))
        credential_file.chmod(0o600)
        token = secrets.token_urlsafe(32)
        with socket.socket() as reserve:
            reserve.bind(("127.0.0.1", 0))
            port = reserve.getsockname()[1]
        env = dict(os.environ, ARUVI_APP_DATA_DIR=str(data), ARUVI_DB_PATH=str(data / "test.db"),
                   ARUVI_LLM_CONFIG_PATH=str(credential_file), ARUVI_WEBHOOK_HOST="127.0.0.1",
                   ARUVI_WEBHOOK_PORT=str(port), ARUVI_MCP_API_TOKEN=token, ARUVI_MOBILE_API_TOKEN=token)
        process = subprocess.Popen([str(binary)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        process_cleanup.callback(stop_process, process)
        address = f"http://127.0.0.1:{port}"
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), config.RejectRedirects())
        deadline = time.monotonic() + 45
        while True:
            if process.poll() is not None: raise CheckError("Native Studio server exited before becoming healthy")
            try:
                owners = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"], capture_output=True, text=True, check=False).stdout.split()
                if str(process.pid) in owners:
                    with opener.open(address + "/health", timeout=2) as response:
                        if response.status == 200: break
            except (OSError, urllib.error.URLError):
                pass
            if time.monotonic() >= deadline: raise CheckError("Native Studio server did not become healthy")
            time.sleep(0.2)
        def call(action, arguments, tool="aruvi_models"):
            body = {"jsonrpc":"2.0", "id":1, "method":"tools/call", "params":{"name":tool, "arguments":{"action":action, "arguments":arguments}}}
            request = urllib.request.Request(address + "/api/mcp", data=json.dumps(body).encode(), headers={"Authorization":"Bearer " + token, "Content-Type":"application/json"})
            with opener.open(request, timeout=180) as response: result = json.load(response)["result"]
            if result.get("isError"):
                detail = json.dumps(result.get("content", []))
                suffix = " (token limit)" if "truncated by a token limit" in detail else ""
                raise CheckError("Native MCP action failed: " + action + suffix)
            return result["structuredContent"]["result"]
        provider = call("create_provider", {"name":"Native fixture", "base_url":f"http://127.0.0.1:{host_port}/v1", "auth_secret_ref":"ref:"+reference})
        discovered = call("discover_provider_models", {"id":provider["id"]})
        if not any(model["id"] == args.model for model in discovered["models"]): raise CheckError("Selected model was not discovered")
        result = call("run_model_chat_completion", {"provider_id":provider["id"], "model":args.model,
            "messages":[{"role":"system", "content":"Return only the requested JavaScript function, without explanation or markdown."}, {"role":"user", "content":"Write function sumEven(numbers) that returns the sum of even integers."}], "temperature":0.1, "max_tokens":512})
        if "sumEven" not in result.get("content", ""): raise CheckError("Native model response did not contain the requested function")
        print("Native Studio MCP discovered the host model and returned coding output.")
        if speech:
            speech_provider = call("create_provider", {"name":"Native speech fixture", "base_url":f"http://127.0.0.1:{speech[0]}/v1", "auth_secret_ref":"ref:"+speech_reference})
            phrase = "The quick brown fox jumps over the lazy dog."
            audio = call("generate_speech", {"provider_id":speech_provider["id"], "model":args.voice_model, "text":phrase}, "aruvi_speech")
            if audio.get("mime_type") != "audio/wav": raise CheckError("Native speech did not return WAV")
            with wave.open(io.BytesIO(base64.b64decode(audio["audio_bytes_base64"], validate=True)), "rb") as wav:
                if wav.getnframes() == 0 or wav.getframerate() == 0: raise CheckError("Native speech returned empty audio")
            transcript = call("transcribe_audio", {"provider_id":speech_provider["id"], "model_name":args.transcription_model,
                "audio_bytes_base64":audio["audio_bytes_base64"], "mime_type":"audio/wav", "locale":"en"}, "aruvi_speech")
            words = re.findall(r"[a-z]+", transcript["transcript"].lower())
            if not {"fox", "dog"}.issubset(words) or SequenceMatcher(None, re.findall(r"[a-z]+", phrase.lower()), words, autojunk=False).ratio() < 0.7:
                raise CheckError("Native synthetic speech transcription did not match the fixture")
            print("Native Studio MCP generated and transcribed synthetic speech through Model Host.")
except (OSError, ValueError, KeyError, TypeError, StopIteration, subprocess.SubprocessError, urllib.error.URLError, wave.Error) as error:
    print(f"Native Model Host check failed: {error}" if isinstance(error, CheckError) else f"Native Model Host check failed ({type(error).__name__})", file=sys.stderr)
    sys.exit(1)
finally:
    if process is not None: stop_process(process)
