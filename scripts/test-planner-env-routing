#!/usr/bin/env python3
"""Check planner environment precedence on isolated, disposable servers."""
import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOKEN = "isolated-planner-env-test"
PROVIDER = "lm-studio-default"
MODEL = "deepseek-coder"


def command(*args):
    return subprocess.check_output(args, text=True).strip()


def call(address, tool, action, arguments):
    data = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {
        "name": tool, "arguments": {"action": action, "arguments": arguments},
    }}).encode()
    request = urllib.request.Request(f"http://{address}/api/mcp", data=data, headers={
        "Authorization": f"Bearer {TOKEN}", "Content-Type": "application/json", "Accept": "application/json",
    })
    with urllib.request.urlopen(request, timeout=30) as response:
        message = json.load(response)
    if "error" in message or "result" not in message:
        raise ValueError("Unexpected MCP protocol response")
    return message["result"]


def run_case(image, case):
    name = f"aruvi-planner-env-{uuid.uuid4().hex[:12]}"
    started = False
    try:
        args = ["docker", "run", "--rm", "-d", "--name", name, "-p", "127.0.0.1::8787",
                "--tmpfs", "/data:mode=1777", "-e", f"ARUVI_MCP_API_TOKEN={TOKEN}"]
        for key, value in case["env"].items():
            args.extend(["-e", f"{key}={value}"])
        command(*(args + [image]))
        started = True
        address = command("docker", "port", name, "8787/tcp").splitlines()[0]
        if not address.startswith("127.0.0.1:"):
            raise ValueError("Fixture is not loopback-only")
        deadline = time.monotonic() + 45
        while True:
            try:
                with urllib.request.urlopen(f"http://{address}/health", timeout=2) as response:
                    if response.status == 200:
                        break
            except (OSError, urllib.error.URLError):
                if time.monotonic() >= deadline:
                    raise ValueError("Fixture did not become healthy")
                time.sleep(0.2)
        for key, value in case["saved"].items():
            result = call(address, "aruvi_settings", "set_setting", {"key": key, "value": value})
            if result.get("isError"):
                raise ValueError("Unable to configure saved fixture default")
        result = call(address, "aruvi_planner", "create_planner_session", {})
        if case["ok"]:
            info = result.get("structuredContent", {}).get("result", {})
            if result.get("isError") or (info.get("provider_id"), info.get("model_name")) != (PROVIDER, MODEL):
                raise ValueError("Planner resolved to an unexpected provider/model")
        elif not result.get("isError") or "configured planner default" not in json.dumps(result.get("content", [])):
            raise ValueError("Invalid configured planner default was not rejected")
        explicit = call(address, "aruvi_planner", "create_planner_session", {"provider_id": PROVIDER, "model_name": MODEL})
        info = explicit.get("structuredContent", {}).get("result", {})
        if explicit.get("isError") or (info.get("provider_id"), info.get("model_name")) != (PROVIDER, MODEL):
            raise ValueError("Explicit session selection did not take precedence")
        print(f"{case['name']}: passed", flush=True)
    finally:
        if started:
            subprocess.run(["docker", "rm", "-f", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    plan = json.loads(command("bash", "scripts/env", "worktree", "plan"))
    env_file = Path(plan["state"]) / "environment.env"
    image = next(line.split("=", 1)[1] for line in env_file.read_text().splitlines() if line.startswith("APP_IMAGE="))
    pkey, mkey = "planner.default_provider_id", "planner.default_model_name"
    ep, em = "ARUVI_PLANNER_PROVIDER_ID", "ARUVI_PLANNER_MODEL_NAME"
    cases = [
        {"name": "environment overrides invalid saved pair", "env": {ep: PROVIDER, em: MODEL}, "saved": {pkey: "missing", mkey: "missing"}, "ok": True},
        {"name": "invalid environment provider rejects valid saved pair", "env": {ep: "missing", em: MODEL}, "saved": {pkey: PROVIDER, mkey: MODEL}, "ok": False},
        {"name": "partial provider override combines with saved model", "env": {ep: PROVIDER}, "saved": {pkey: "missing", mkey: MODEL}, "ok": True},
        {"name": "invalid model override rejects valid saved pair", "env": {em: "missing"}, "saved": {pkey: PROVIDER, mkey: MODEL}, "ok": False},
        {"name": "partial model override respects invalid saved provider", "env": {em: MODEL}, "saved": {pkey: "missing", mkey: MODEL}, "ok": False},
        {"name": "blank environment values use saved defaults", "env": {ep: "", em: ""}, "saved": {pkey: PROVIDER, mkey: MODEL}, "ok": True},
    ]
    for case in cases:
        run_case(image, case)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, StopIteration, subprocess.CalledProcessError) as error:
        print(f"Planner environment routing test failed: {type(error).__name__}: {error}", file=sys.stderr)
        sys.exit(1)
