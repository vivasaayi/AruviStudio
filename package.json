{
  "name": "aruvi-studio",
  "private": true,
  "version": "0.1.7",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:rotate": "node scripts/rotate-version.mjs",
    "release:local": "bash release_local.sh",
    "release:mac": "bash release_macos_direct.sh",
    "unit-test": "node scripts/ci/run-rust-test-suite.mjs unit",
    "integration-test": "node scripts/ci/run-rust-test-suite.mjs integration",
    "terminology-check": "node scripts/ci/check-product-area-terminology.mjs",
    "test:frontend": "vitest run --coverage",
    "e2e-tests": "node scripts/ci/run-playwright-suite.mjs",
    "test:rust:unit": "npm run unit-test",
    "test:rust:integration": "npm run integration-test",
    "test:e2e:raw": "playwright test",
    "test:e2e": "npm run e2e-tests",
    "test:all": "npm run terminology-check && npm run unit-test && npm run test:frontend && npm run integration-test && npm run e2e-tests",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "2.10.0",
    "@tauri-apps/cli-darwin-x64": "2.10.0",
    "@tauri-apps/cli-linux-x64-gnu": "2.10.0",
    "@tauri-apps/cli-win32-x64-msvc": "2.10.0"
  }
}
