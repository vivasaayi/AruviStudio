+"""Disposable Studio and simulated Model Host scoped-credential integration."""
+import json, os, socket, subprocess, tempfile, time, urllib.error, urllib.request
+from pathlib import Path
+from tests.lifecycle import Lifecycle
+
+host = Lifecycle('test_inference_token_cannot_manage_the_host')
+host.setUp()
+child = None
+try:
+    host.register()
+    assert host.install()['installation'] == 'installed'
+    with tempfile.TemporaryDirectory(prefix='studio-scoped-host-', dir='/private/tmp') as directory:
+        root = Path(directory)
+        with socket.socket() as reserved:
+            reserved.bind(('127.0.0.1', 0))
+            port = reserved.getsockname()[1]
+        credential_file = root / 'llm.json'
+        credential_file.write_text(json.dumps({'refs':{'fixture':'fixture-inference-token'}}))
+        credential_file.chmod(0o600)
+        environment = {k:v for k,v in os.environ.items() if not k.startswith('ARUVI_')}
+        environment.update(ARUVI_APP_DATA_DIR=str(root), ARUVI_DB_PATH=str(root / 'studio.db'),
+            ARUVI_LLM_CONFIG_PATH=str(root / 'llm.json'), ARUVI_WEBHOOK_HOST='127.0.0.1',
+            ARUVI_WEBHOOK_PORT=str(port), ARUVI_MOBILE_API_TOKEN='studio-fixture-token', ARUVI_MCP_API_TOKEN='studio-fixture-token')
+        child = subprocess.Popen([os.environ['ARUVI_STUDIO_TEST_BIN']], env=environment, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        base = f'http://127.0.0.1:{port}'
+        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+        for _ in range(100):
+            if child.poll() is not None: raise RuntimeError('Studio stopped before readiness')
+            try:
+                with opener.open(base + '/health', timeout=1): break
+            except OSError: time.sleep(.1)
+        else: raise RuntimeError('Studio readiness timed out')
+        def mcp(action, arguments):
+            payload = {'jsonrpc':'2.0', 'id':1, 'method':'tools/call', 'params':{'name':'aruvi_models', 'arguments':{'action':action, 'arguments':arguments}}}
+            req = urllib.request.Request(base + '/api/mcp', data=json.dumps(payload).encode(), headers={'Authorization':'Bearer studio-fixture-token', 'Content-Type':'application/json'})
+            with opener.open(req, timeout=10) as response: result = json.load(response)['result']
+            if result.get('isError'): raise RuntimeError('MCP fixture failed: ' + action + ': ' + json.dumps(result.get('content', [])))
+            return result['structuredContent']['result']
+        provider = mcp('create_provider', {'name':'scoped fixture', 'base_url':host.url + '/v1', 'auth_secret_ref':'ref:fixture'})
+        result = mcp('run_model_chat_completion', {'provider_id':provider['id'], 'model':'fixture', 'messages':[{'role':'user','content':'hello'}], 'max_tokens':20})
+        assert result['content'] == 'fixture response'
+        req = urllib.request.Request(host.url + '/api/models', headers={'Authorization':'Bearer fixture-inference-token'})
+        try:
+            opener.open(req, timeout=2)
+            raise AssertionError('Management unexpectedly allowed')
+        except urllib.error.HTTPError as error: assert error.code == 403
+        print('Disposable Studio MCP completion passed with inference-only token; host management denied.')
+finally:
+    if child is not None and child.poll() is None:
+        child.terminate()
+        child.wait(timeout=10)
+    host.tearDown()
