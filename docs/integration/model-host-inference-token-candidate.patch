+"""Disposable containerized Studio and simulated scoped Model Host check."""
+import importlib.machinery, json, os, subprocess, time, urllib.error, urllib.request
+from tests.lifecycle import Lifecycle
+
+host = Lifecycle('test_inference_token_cannot_manage_the_host')
+host.setUp()
+container = None
+try:
+    host.register()
+    assert host.install()['installation'] == 'installed'
+    result = subprocess.run(['docker','run','-d','--rm','--tmpfs','/data:mode=1777','--tmpfs','/repositories:mode=1777',
+      '-p','127.0.0.1::8787','-e','ARUVI_MOBILE_API_TOKEN=studio-fixture-token','-e','ARUVI_MCP_API_TOKEN=studio-fixture-token',
+      '-e','ARUVI_LLM_CONFIG_PATH=/data/llm.json',os.environ['ARUVI_STUDIO_TEST_IMAGE']],check=True,capture_output=True,text=True)
+    container = result.stdout.strip()
+    address = subprocess.check_output(['docker','port',container,'8787/tcp'],text=True).strip().splitlines()[0]
+    if not address.startswith('127.0.0.1:'): raise RuntimeError('Fixture is not bound to loopback')
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    base = 'http://' + address
+    for _ in range(200):
+        try:
+            with opener.open(base + '/health', timeout=1): break
+        except OSError: time.sleep(.1)
+    else: raise RuntimeError('Studio readiness timed out')
+    def mcp(action, arguments):
+        body = {'jsonrpc':'2.0','id':1,'method':'tools/call','params':{'name':'aruvi_models','arguments':{'action':action,'arguments':arguments}}}
+        req = urllib.request.Request(base + '/api/mcp',data=json.dumps(body).encode(),headers={'Authorization':'Bearer studio-fixture-token','Content-Type':'application/json'})
+        with opener.open(req,timeout=30) as response: result = json.load(response)['result']
+        if result.get('isError'): raise RuntimeError('MCP fixture failed: ' + action)
+        return result['structuredContent']['result']
+    host_port = host.url.rsplit(':',1)[1]
+    helper = importlib.machinery.SourceFileLoader('studio_host_helper', os.path.join(os.environ['ARUVI_STUDIO_ROOT'], 'scripts/configure-native-model-host')).load_module()
+    helper.mcp = mcp
+    helper.verify_inference_scope(int(host_port), 'fixture-inference-token')
+    configured = helper.configure(int(host_port), 'fixture-inference-token', 'fixture', 'scoped fixture')
+    again = helper.configure(int(host_port), 'fixture-inference-token', 'fixture', 'scoped fixture', rotate_credential=False)
+    assert again['provider_id'] == configured['provider_id']
+    response = mcp('run_model_chat_completion', {'provider_id':configured['provider_id'],'model':'fixture','messages':[{'role':'user','content':'hello'}],'max_tokens':20})
+    assert response['content'] == 'fixture response'
+    print('Disposable Docker Studio helper configuration and MCP completion passed with inference-only token.')
+finally:
+    if container:
+        subprocess.run(['docker','stop',container],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+    host.tearDown()
